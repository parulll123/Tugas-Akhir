# ═══════════════════════════════════════════════════════
# .env.example — salin ke .env dan isi sesuai setup kamu
# ═══════════════════════════════════════════════════════

# ── Modbus TCP (ESP32) ───────────────────────────────
MODBUS_HOST=192.168.1.100     # IP statis ESP32
MODBUS_PORT=502               # Port Modbus TCP default
MODBUS_UNIT_ID=1              # Slave ID ESP32

# ── Polling ──────────────────────────────────────────
POLL_INTERVAL=0.5             # Interval polling dalam detik
LOG_EVERY_N=10                # Simpan ke DB setiap N poll (10 × 0.5s = 5s sekali)

# ── Flask ────────────────────────────────────────────
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=false

# ── Database ─────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///motor_monitor.db

# PostgreSQL (production) — uncomment jika pakai
# DATABASE_URL=postgresql://user:password@localhost:5432/motor_monitor
